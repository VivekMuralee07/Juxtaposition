<resources>
    <!-- Edge-to-edge: system bar colours and icon contrast are handled by enableEdgeToEdge(). -->
    <style name="Theme.Juxtaposition" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">#FFF8F3</item>
    </style>

    <!-- Launch screen: the app's orange with the pin icon, then the normal theme. -->
    <style name="Theme.Juxtaposition.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#D9480F</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Juxtaposition</item>
    </style>
</resources>
